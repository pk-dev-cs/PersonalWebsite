---
import { navigation, profile, site, type Section } from '../config';
import PageTransitions from '../components/PageTransitions.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  section?: Section;
  article?: { published: string; modified?: string };
  noindex?: boolean;
}

const { title, description, section, article, noindex = false } = Astro.props;
const active = navigation.find((item) => item.label === section);
const canonical = new URL(Astro.url.pathname, site.origin).href;
const fullTitle = `${title} | ${site.title}`;
const person = {
  '@type': 'Person',
  '@id': `${site.origin}/#person`,
  name: site.title,
  url: `${site.origin}/`,
  ...(profile.email ? { email: profile.email } : {}),
  ...(profile.socialLinks.length ? { sameAs: profile.socialLinks.map((link) => link.url) } : {}),
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite', '@id': `${site.origin}/#website`,
      url: `${site.origin}/`, name: `${site.title} / portfolio`, inLanguage: site.language,
    },
    {
      '@type': article ? 'BlogPosting' : section === 'About' ? 'AboutPage' : section === 'Contact' ? 'ContactPage' : 'WebPage',
      '@id': canonical, url: canonical, headline: title, description,
      isPartOf: { '@id': `${site.origin}/#website` },
      ...(article ? {
        datePublished: article.published,
        dateModified: article.modified ?? article.published,
        author: { '@id': `${site.origin}/#person` },
        image: `${site.origin}/social-card.png`,
        mainEntityOfPage: canonical,
      } : {}),
    },
  ],
};
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#13191b" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || site.placeholderOrigin ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} - Blog`} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={`${site.title} / portfolio`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.origin}/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Less, but better. A minimal terminal-inspired portfolio." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.origin}/social-card.png`} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified} />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <PageTransitions />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-wrap">
      <div class="terminal-window">
        <header>
          <div class="titlebar">
            <a class="brand" href="/" aria-label="pkdev - About">[ pkdev ]</a>
            <span class="window-marks" aria-hidden="true">_ &nbsp; [] &nbsp; x</span>
          </div>
          <nav aria-label="Main navigation">
            {navigation.map((item) => (
              <a href={item.href} aria-current={section === item.label ? 'page' : undefined}>
                <span>{item.number}</span> {item.label}
              </a>
            ))}
            <span class="nav-note" aria-hidden="true">[ less is more ]</span>
          </nav>
        </header>
        <main id="main" tabindex="-1">
          <div class="path-line" aria-hidden="true">
            <span>~/portfolio/{section?.toLowerCase() ?? 'not-found'}</span>
            <span>{active ? `${active.number} / 04` : '404'}</span>
          </div>
          <slot />
        </main>
        <footer class="statusbar">
          <span class="status-mode">NORMAL</span>
          <span class="status-file">{active?.file ?? '404.md'}</span>
          <span class="status-count">{active ? `${Number(active.number)} of 4` : 'not found'}</span>
        </footer>
      </div>
      <div class="outer-line outer-bottom"><span>LESS GUI. MORE YOU.</span><span>© Copyright {new Date().getFullYear()}, Przemysław Kleszcz.</span></div>
    </div>
  </body>
</html>
