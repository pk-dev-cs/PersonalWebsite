---
import Layout from '../layouts/Layout.astro';
import { profile, resume } from '../config';
import { Image } from 'astro:assets';
import portrait from '../assets/przemyslaw-kleszcz.jpg';

const monthFormat = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const formatMonth = (value: string) => monthFormat.format(new Date(`${value}-01T00:00:00Z`));
---
<Layout title="Resume" description={`${profile.firstName} ${profile.lastName} - ${resume.experience[0].role} with experience in .NET, Angular, software architecture, and leading development teams.`} section="Resume">
  <div class="content-page resume-page">
    <p class="command">$ cat resume.md</p>
    <header class="resume-header">
      <div>
        <h1>{profile.firstName} {profile.lastName}</h1>
        <p class="resume-role">{resume.experience[0].role}</p>
        <p class="lead">{resume.intro}</p>
        <div class="resume-details">
          <span>{profile.location}</span>
          {profile.email && <a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a>}
        </div>
      </div>
      <Image
        class="resume-photo"
        src={portrait}
        alt={`${profile.firstName} ${profile.lastName}`}
        width={176}
        height={220}
        widths={[176, 352]}
        sizes="(max-width: 640px) 144px, 176px"
        format="webp"
        quality={80}
        loading="eager"
        decoding="async"
      />
    </header>
    <section class="resume-section" aria-labelledby="experience">
      <h2 id="experience"><span class="section-number">01 /</span> Experience</h2>
      {resume.experience.map((job) => (
        <article class="experience-row">
          <p class="period"><time datetime={job.start}>{formatMonth(job.start)}</time> - {job.end ? <time datetime={job.end}>{formatMonth(job.end)}</time> : 'Present'}</p>
          <div>
            <h3>{job.role}</h3>
            <p class="company">{job.company}{job.location && <> <span class="muted">/ {job.location}</span></>}</p>
            {job.responsibilities.length > 0 && <ul class="responsibilities">{job.responsibilities.map((responsibility) => <li>{responsibility}</li>)}</ul>}
          </div>
        </article>
      ))}
    </section>
    <section class="resume-section" aria-labelledby="toolkit">
      <h2 id="toolkit"><span class="section-number">02 /</span> Toolkit</h2>
      <div class="skill-groups">
        {resume.skills.map((group) => (
          <div class="skill-group">
            <h3>{group.category}</h3>
            <ul class="tags">{group.items.map((skill) => <li>{skill}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>
    <section class="resume-section" aria-labelledby="education">
      <h2 id="education"><span class="section-number">03 /</span> Education</h2>
      <h3>{resume.education.degree}</h3>
      <p class="education-institution">{resume.education.institution} / {resume.education.location}</p>
    </section>
    <section class="resume-section" aria-labelledby="languages">
      <h2 id="languages"><span class="section-number">04 /</span> Languages</h2>
      <ul class="tags">{resume.languages.map((language) => <li>{language}</li>)}</ul>
    </section>
    <a class="text-link" href="/contact/">Start a conversation <span aria-hidden="true">-&gt;</span></a>
  </div>
</Layout>
