---
import Layout from '../../layouts/Layout.astro';
import { publishedPosts, formatDate } from '../../lib/blog';
const posts = await publishedPosts();
---
<Layout title="Blog" description="Notes on the web, thoughtful design, and doing more with less." section="Blog">
  <div class="content-page">
    <div class="section-topline"><p class="command">$ ls writing/</p><a class="text-link" href="/rss.xml">RSS feed <span aria-hidden="true">↗</span></a></div>
    <h1>Notes from the terminal<span class="heading-dot">.</span></h1>
    <p class="lead">Things learned, ideas in progress, and a little thinking out loud.</p>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{post.data.example && <span>Example post</span>}</div>
          <h2><a href={`/blog/${post.id}/`}>{post.data.title}<span aria-hidden="true"> -&gt;</span></a></h2>
          <p>{post.data.description}</p>
          <ul class="inline-tags" aria-label="Topics">{post.data.tags.map((tag) => <li>#{tag}</li>)}</ul>
        </li>
      ))}
    </ul>
    {posts.length === 0 && <p class="empty-state">No posts yet. Good things take a little time.</p>}
  </div>
</Layout>
