---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" description="This path does not exist. Find your way back to the portfolio." noindex>
  <div class="content-page not-found">
    <p class="command">$ cd unknown-path</p>
    <h1>404<span class="heading-dot">_</span></h1>
    <p class="lead">A path less travelled. Or one that doesn't exist.</p>
    <p>The page may have moved, or the address might be a little off.</p>
    <a class="button" href="/">Back to About <span aria-hidden="true">-&gt;</span></a>
  </div>
</Layout>
