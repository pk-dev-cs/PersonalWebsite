---
import Layout from '../layouts/Layout.astro';
import { profile } from '../config';

const socialIcons: Record<string, string> = {
  LinkedIn: 'M5 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3 9h4v12H3Zm7 0h4v2c1-3 7-3 7 3v7h-4v-7c0-3-3-3-3 0v7h-4Z',
  Facebook: 'M14 22v-9h3l.5-4H14V7c0-1 .5-2 2-2h2V1h-3c-3 0-5 2-5 5v3H7v4h3v9Z',
  GitHub: 'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.26-.45-1.28.1-2.66 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.79c.85 0 1.7.11 2.5.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.66.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.77c0 .27.18.58.69.48A10 10 0 0 0 12 2Z',
};
---
<Layout title="Contact" description="A good conversation is where thoughtful work begins. Get in touch." section="Contact">
  <div class="content-page contact-page">
    <p class="command">$ open conversation</p>
    <h1>Say hello<span class="heading-dot">_</span></h1>
    <p class="lead">Have an idea, a question, or something worth making?<br />A good conversation is a good place to start.</p>
    <div class="contact-block">
      <h2>Inbox</h2>
      {profile.email
        ? <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">-&gt;</span></a>
        : <><p class="contact-placeholder">Contact details not configured yet.</p><p class="muted">This is a prototype. No messages are collected or sent.</p></>}
    </div>
    {profile.socialLinks.length > 0 && (
      <div class="contact-block">
        <h2>Elsewhere</h2>
        <ul class="contact-links">
          {profile.socialLinks.map((link) => (
            <li>
              <a class="text-link" href={link.url}>
                {socialIcons[link.label] && (
                  <svg class="social-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d={socialIcons[link.label]} />
                  </svg>
                )}
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class="contact-signoff"><span class="square" aria-hidden="true"></span>{profile.availability}<span class="muted"> / {profile.location}</span></div>
    {profile.example && <p class="example-note">Availability and location are examples. Replace them with your own.</p>}
  </div>
</Layout>
