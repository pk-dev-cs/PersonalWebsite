<script is:inline data-page-transitions>
  (() => {
    if ('CSSViewTransitionRule' in window) return;

    const root = document.documentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let leaving = false;
    let navigationTimer;

    const enter = () => {
      if (!reducedMotion.matches) root.classList.add('page-is-entering');
    };
    enter();

    root.addEventListener('animationend', (event) => {
      if (event.target instanceof Element && event.target.matches('.terminal-window') &&
          event.animationName === 'page-fade-in') {
        root.classList.remove('page-is-entering');
      }
    });

    window.addEventListener('pageshow', (event) => {
      window.clearTimeout(navigationTimer);
      leaving = false;
      root.classList.remove('page-is-leaving');
      if (event.persisted) enter();
    });

    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
          event.ctrlKey || event.shiftKey || event.altKey || reducedMotion.matches) return;
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest('a[href]');
      if (!(link instanceof HTMLAnchorElement) || link.hasAttribute('download') ||
          (link.target && link.target !== '_self')) return;

      const url = new URL(link.href);
      if (url.origin !== location.origin ||
          !['http:', 'https:'].includes(url.protocol) ||
          (url.pathname === location.pathname && url.search === location.search) ||
          (/\.[^/]+$/.test(url.pathname) && !/\.html?$/i.test(url.pathname))) return;

      const terminal = document.querySelector('.terminal-window');
      if (!terminal) return;

      event.preventDefault();
      if (leaving) return;
      leaving = true;
      root.classList.remove('page-is-entering');
      root.classList.add('page-is-leaving');
      const duration = parseFloat(getComputedStyle(terminal).animationDuration) * 1000;
      navigationTimer = window.setTimeout(() => location.assign(url.href), duration);
    });
  })();
</script>
